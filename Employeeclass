 class Employee {
    String name;
    float salary;
    Employee(String name,float salary) {
       this. name = name;
       this. salary = salary;

    }
     void display(){
        System.out.println(name);
        System.out.println(salary);


    }

}
class Main1 {
    public static void main (){
        Employee emp=new Employee("rahul" , 2500);
        emp.display();


    }
}
