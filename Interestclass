import java.util.*;

class Interest1 {
    double principal, rate, time;

    // Constructor to initialize values and calculate simple interest
    Interest1(double p, double r, double t) {
        principal = p;
        rate = r;
        time = t;

        double si = (principal * rate * time) / 100;
        System.out.println("Simple Interest: " + si);
    }
}

